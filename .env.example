# Environment Configuration for Counterfeit Detector

# Server Configuration
ENV=development
DEBUG=True
PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# PostgreSQL + pgvector
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=counterfeit_detector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/counterfeit_detector

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=cloudflare_r2 # or local / s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=counterfeit-detector-uploads
R2_PUBLIC_DOMAIN=https://cdn.counterfeitdetector.ng

# Vision Model Configuration
MODEL_DEVICE=cpu # or cuda
YOLO_MODEL_PATH=packages/vision-engine/models/yolov11n_packaging.pt
SIMILARITY_THRESHOLD_HIGH=0.85
SIMILARITY_THRESHOLD_SUSPICIOUS=0.60
